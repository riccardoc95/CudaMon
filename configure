#!/bin/sh
set -e

R_BIN="${R_HOME:+$R_HOME/bin/R}"
if [ -z "$R_BIN" ] || [ ! -x "$R_BIN" ]; then
  R_BIN=$(command -v R || true)
fi

if [ -z "$R_BIN" ]; then
  echo "configure: error: R executable not found" 1>&2
  exit 1
fi

R_INCL=$("$R_BIN" CMD config --cppflags)

HAVE_NVML=0
NVML_CFLAGS=
NVML_LIBS=

find_nvml_from_cuda_tree() {
  base="$1"
  arch="$2"

  inc="$base/targets/${arch}-linux/include"
  lib="$base/targets/${arch}-linux/lib/stubs"

  if [ -f "$inc/nvml.h" ] && [ -f "$lib/libnvidia-ml.so" ]; then
    echo "$inc|$lib"
    return 0
  fi

  return 1
}

detect_nvml_paths() {
  arch="$(uname -m)"

  # if NVML_INCLUDE_DIR and NVML_LIB_DIR are set, use them
  if [ -n "${NVML_INCLUDE_DIR:-}" ] && [ -n "${NVML_LIB_DIR:-}" ] &&
     [ -f "${NVML_INCLUDE_DIR}/nvml.h" ] &&
     [ -f "${NVML_LIB_DIR}/libnvidia-ml.so" ]; then
    echo "${NVML_INCLUDE_DIR}|${NVML_LIB_DIR}"
    return 0
  fi

  # if CUDA_HOME or CUDA_PATH are set, try to find NVML there
  for base in "${CUDA_HOME:-}" "${CUDA_PATH:-}"; do
    if [ -n "$base" ]; then
      if result=$(find_nvml_from_cuda_tree "$base" "$arch"); then
        echo "$result"
        return 0
      fi
    fi
  done

  # if /usr/local/cuda exists, try to find NVML there
  if result=$(find_nvml_from_cuda_tree "/usr/local/cuda" "$arch"); then
    echo "$result"
    return 0
  fi

  # if /usr/local/cuda-* exists, try to find NVML there, starting from the highest version
  for base in $(ls -d /usr/local/cuda-* 2>/dev/null | sort -V -r); do
    if result=$(find_nvml_from_cuda_tree "$base" "$arch"); then
      echo "$result"
      return 0
    fi
  done

  return 1
}

if result=$(detect_nvml_paths); then
  NVML_INCLUDE_DIR=${result%|*}
  NVML_LIB_DIR=${result#*|}

  NVML_CFLAGS="-I${NVML_INCLUDE_DIR}"
  NVML_LIBS="-L${NVML_LIB_DIR} -lnvidia-ml"
  HAVE_NVML=1
fi

if [ "$HAVE_NVML" -eq 1 ]; then
  echo "configure: NVML support enabled"
  echo "configure: NVML include dir: ${NVML_INCLUDE_DIR}"
  echo "configure: NVML lib dir: ${NVML_LIB_DIR}"
  PKG_CPPFLAGS="${R_INCL} ${NVML_CFLAGS} -DHAVE_NVML=1"
  PKG_LIBS="${NVML_LIBS} ${SHLIB_LINK}"
else
  echo "configure: NVML support disabled; building stub implementation"
  PKG_CPPFLAGS="${R_INCL}"
  PKG_LIBS="${SHLIB_LINK}"
fi

sed \
  -e "s|@PKG_CPPFLAGS@|${PKG_CPPFLAGS}|g" \
  -e "s|@PKG_LIBS@|${PKG_LIBS}|g" \
  src/Makevars.in > src/Makevars

echo "configure: generated src/Makevars"
