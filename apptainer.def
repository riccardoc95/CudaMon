Bootstrap: docker
From: nvidia/cuda:13.1.1-devel-ubuntu24.04

%files
    . /opt/CudaMon

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/usr/local/bin:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        gfortran \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        python3 \
        python3-pip \
        r-base \
        r-base-dev
    rm -rf /var/lib/apt/lists/*

    R -q -e "options(repos = c(CRAN = 'https://cloud.r-project.org')); install.packages(c('ggplot2', 'processx', 'testthat', 'reticulate'))"

    python3 -m pip install --break-system-packages --no-cache-dir numpy torch

    cd /opt/CudaMon
    R CMD INSTALL .

%runscript
    exec R -q -e "library(CudaMon); cat('nvml_is_available:', nvml_is_available(), '\n'); if (nvml_is_available()) cat('nvml_device_count:', nvml_device_count(), '\n')"

%test
    R -q -e "library(CudaMon); stopifnot(is.logical(nvml_is_available()), length(nvml_is_available()) == 1L)"
